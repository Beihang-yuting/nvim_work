// sample.sv —— smoke test fixture
module sample (
    input  logic clk,
    input  logic rst_n,
    output logic q
);

  logic [7:0]  data_a;
  logic [31:0] address_long;
  logic        enable;
  int          counter = 0;

  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) q <= 1'b0;
    else q <= enable;
  end

endmodule
