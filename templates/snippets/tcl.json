{
  "proc": {
    "prefix": "proc",
    "body": [
      "proc ${1:name} {${2:args}} {",
      "  ${3:# body}",
      "}"
    ]
  },
  "puts": {
    "prefix": "puts",
    "body": ["puts \"${1:msg}\""]
  },
  "package require": {
    "prefix": "pkg",
    "body": ["package require ${1:Tcl} ${2:8.6}"]
  }
}
