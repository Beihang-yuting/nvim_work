{
  "class": {
    "prefix": "cls",
    "body": [
      "class ${1:Name} {",
      "public:",
      "  ${1:Name}();",
      "  ~${1:Name}();",
      "private:",
      "  ${2:// members}",
      "};"
    ]
  },
  "header guard": {
    "prefix": "ifndef",
    "body": [
      "#ifndef ${1:GUARD}",
      "#define ${1:GUARD}",
      "",
      "${2:// declarations}",
      "",
      "#endif  // ${1:GUARD}"
    ]
  },
  "namespace": {
    "prefix": "nspace",
    "body": [
      "namespace ${1:name} {",
      "",
      "${2:// content}",
      "",
      "}  // namespace ${1:name}"
    ]
  }
}
